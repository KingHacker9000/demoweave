{
  "schemaVersion": 1,
  "id": "inspect-project",
  "title": "Inspect DemoWeave with DemoWeave",
  "description": "Runs the built DemoWeave CLI against its own repository and captures terminal evidence.",
  "surfaceId": "terminal-demoweave-cli",
  "sources": [
    {
      "path": "packages/cli/src/index.ts",
      "role": "implementation"
    },
    {
      "path": "packages/core/src/analyzer.ts",
      "role": "implementation"
    }
  ],
  "steps": [
    {
      "id": "run-inspect",
      "type": "run",
      "command": "node",
      "args": ["packages/cli/dist/index.js", "inspect", "."]
    },
    {
      "id": "assert-surfaces",
      "type": "assert",
      "assertion": {
        "kind": "outputContains",
        "stream": "stdout",
        "value": "Detected surfaces"
      }
    },
    {
      "id": "assert-success",
      "type": "assert",
      "assertion": {
        "kind": "exitCode",
        "value": 0
      }
    },
    {
      "id": "capture-terminal",
      "type": "capture",
      "evidenceId": "inspect-project-terminal",
      "kind": "terminal"
    }
  ]
}
