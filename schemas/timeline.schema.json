{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/timeline.schema.json",
  "title": "DemoWeave TimelinePlan v1",
  "description": "A deterministic presentation-only plan for composing local Evidence and media. Runtime validation additionally checks unique ids, safe paths, source existence, and supported formats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "canvas", "scenes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "maximum": 7680, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 64, "maximum": 4320, "multipleOf": 2 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$" },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidenceId"],
          "properties": { "kind": { "const": "evidence" }, "evidenceId": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": { "kind": { "const": "file" }, "path": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "fit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/source" },
        "fit": { "enum": ["contain", "cover"] }
      }
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "single" },
            "padding": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "direction"],
          "properties": {
            "type": { "const": "split" },
            "direction": { "const": "horizontal" },
            "gap": { "type": "integer", "minimum": 0 },
            "padding": { "type": "integer", "minimum": 0 },
            "ratio": { "type": "number", "minimum": 0.1, "maximum": 0.9 }
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationMs", "layout", "panes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "durationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "transition": { "const": "cut" },
        "layout": { "$ref": "#/$defs/layout" },
        "panes": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/pane" } }
      }
    }
  }
}
