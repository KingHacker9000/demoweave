{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/publisher-plan.schema.json",
  "title": "DemoWeave PublisherPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "publisher", "targetRoot", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/portableId" },
    "publisher": { "type": "string", "minLength": 1 },
    "targetRoot": { "$ref": "#/$defs/portablePath" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination"],
        "properties": {
          "source": { "allOf": [{ "$ref": "#/$defs/portablePath" }, { "pattern": "\\.[mM][dD](?:[aA][rR][kK][dD][oO][wW][nN])?$" }] },
          "destination": { "$ref": "#/$defs/portablePath" }
        }
      }
    }
  },
  "$defs": {
    "portableId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!\\.\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    }
  }
}
