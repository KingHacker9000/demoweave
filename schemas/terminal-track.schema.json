{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/terminal-track.schema.json",
  "title": "DemoWeave TerminalTrack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "columns", "rows", "mode", "commands", "events", "status", "exitCode", "durationMs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "columns": { "type": "integer", "exclusiveMinimum": 0 },
    "rows": { "type": "integer", "exclusiveMinimum": 0 },
    "mode": { "const": "pipe" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "command", "args", "cwd", "startedAt", "durationMs", "status", "exitCode"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "startedAt": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["completed", "failed", "timedOut", "spawnFailed"] },
          "exitCode": { "type": ["integer", "null"] },
          "signal": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
            "then": { "properties": { "exitCode": { "const": 0 } } }
          },
          {
            "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
            "then": {
              "anyOf": [
                { "properties": { "exitCode": { "type": "integer", "not": { "const": 0 } } } },
                { "properties": { "exitCode": { "const": null } }, "required": ["signal"] }
              ]
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "t", "stepId", "stream", "data"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "t": { "type": "integer", "minimum": 0 },
          "stepId": { "type": "string", "minLength": 1 },
          "stream": { "enum": ["input", "stdout", "stderr"] },
          "data": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["completed", "failed", "timedOut", "spawnFailed"] },
    "exitCode": { "type": ["integer", "null"] },
    "durationMs": { "type": "integer", "minimum": 0 }
  }
}
