{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/publication-manifest.schema.json",
  "title": "DemoWeave PublicationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "publisher", "planHash", "targetRoot", "publishedFiles", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "$ref": "#/$defs/portableId" },
    "publisher": { "type": "string", "minLength": 1 },
    "planHash": { "$ref": "#/$defs/hash" },
    "targetRoot": { "$ref": "#/$defs/portablePath" },
    "publishedFiles": { "type": "array", "items": { "$ref": "#/$defs/publishedFile" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "portableId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "portablePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "publishedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "sourcePath", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "hash": { "$ref": "#/$defs/hash" },
        "sourcePath": { "$ref": "#/$defs/portablePath" },
        "kind": { "enum": ["document", "dependency"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "hash": { "$ref": "#/$defs/hash" },
        "kind": { "enum": ["document", "dependency"] },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
