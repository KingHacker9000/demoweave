{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/tutorial.schema.json",
  "title": "DemoWeave TutorialPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "video", "metadata", "thumbnail", "captions", "chapters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/stableId" },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId"],
      "properties": { "evidenceId": { "$ref": "#/$defs/stableId" } }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 5000 },
        "language": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atMs", "width", "height", "fit", "background"],
      "properties": {
        "atMs": { "$ref": "#/$defs/timestamp" },
        "width": { "type": "integer", "minimum": 320, "maximum": 3840, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 180, "maximum": 2160, "multipleOf": 2 },
        "fit": { "enum": ["contain", "cover"] },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startMs", "endMs", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "startMs": { "$ref": "#/$defs/timestamp" },
          "endMs": { "$ref": "#/$defs/timestamp" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startMs", "title"],
        "properties": {
          "startMs": { "$ref": "#/$defs/timestamp" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$" },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 86400000 }
  }
}
