{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/flow.schema.json",
  "title": "DemoWeave Flow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "surfaceId", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "surfaceId": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value"],
      "properties": {
        "strategy": {
          "enum": ["text", "label", "role", "name", "testId", "accessibilityId", "automationId"]
        },
        "value": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" }
      }
    },
    "stepBase": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "required": ["id"]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "visible" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "hidden" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "textContains" },
            "value": { "type": "string", "minLength": 1 },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stream", "value"],
          "properties": {
            "kind": { "const": "outputContains" },
            "stream": { "enum": ["stdout", "stderr", "combined"] },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "exitCode" },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "fileExists" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "waitCondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ms"],
          "properties": {
            "kind": { "const": "duration" },
            "ms": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "visible" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "hidden" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "text" },
            "value": { "type": "string", "minLength": 1 },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "processExit" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "fileExists" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "command"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "run" },
            "command": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "expectedExitCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "destination"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "navigate" },
            "destination": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "target"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "activate" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "target", "value"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "input" },
            "target": { "$ref": "#/$defs/target" },
            "value": { "type": "string" },
            "clear": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "key"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "press" },
            "key": { "type": "string", "minLength": 1 },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "direction"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "scroll" },
            "direction": { "enum": ["up", "down", "left", "right"] },
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "condition"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "wait" },
            "condition": { "$ref": "#/$defs/waitCondition" },
            "timeoutMs": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "assertion"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "assert" },
            "assertion": { "$ref": "#/$defs/assertion" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "evidenceId", "kind"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "type": { "const": "capture" },
            "evidenceId": { "type": "string", "minLength": 1 },
            "kind": {
              "enum": ["screenshot", "recording", "terminal", "image", "diagram", "plot", "table", "result", "text", "code", "comparison"]
            },
            "target": { "$ref": "#/$defs/target" }
          }
        }
      ]
    }
  }
}
