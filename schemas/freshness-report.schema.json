{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/freshness-report.schema.json",
  "title": "DemoWeave FreshnessReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidence", "documents", "regeneration", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceFreshness" } },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "evidenceIds"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "regeneration": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh", "stale", "missing", "unknown", "impactedDocuments", "actions"],
      "properties": {
        "fresh": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "impactedDocuments": { "type": "integer", "minimum": 0 },
        "actions": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "declared-planned",
            "declared-stale",
            "declared-missing",
            "declared-failed",
            "artifact-missing",
            "artifact-changed",
            "artifact-baseline-unavailable",
            "source-missing",
            "source-changed",
            "source-baseline-unavailable",
            "flow-reference-missing",
            "flow-missing",
            "flow-changed",
            "flow-baseline-unavailable",
            "plugin-changed",
            "plugin-unavailable",
            "upstream-missing",
            "upstream-stale",
            "upstream-unknown"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "upstreamEvidenceId": { "type": "string", "minLength": 1 },
        "expectedHash": { "$ref": "#/$defs/hash" },
        "actualHash": { "$ref": "#/$defs/hash" }
      }
    },
    "evidenceFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "state", "reasons"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["fresh", "stale", "missing", "unknown"] },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" } }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "flowId", "evidenceIds"],
          "properties": {
            "kind": { "const": "run-flow" },
            "flowId": { "type": "string", "minLength": 1 },
            "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceEvidenceId", "evidenceId", "format", "outputPath"],
          "properties": {
            "kind": { "const": "render-evidence" },
            "sourceEvidenceId": { "type": "string", "minLength": 1 },
            "evidenceId": { "type": "string", "minLength": 1 },
            "format": { "enum": ["png", "gif"] },
            "outputPath": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
