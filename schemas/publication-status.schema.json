{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/publication-status.schema.json",
  "title": "DemoWeave PublicationStatus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "state", "reasons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "state": { "enum": ["fresh", "stale", "drifted", "missing", "unpublished", "unknown"] },
    "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["manifest-missing", "manifest-invalid", "plan-changed", "source-missing", "source-changed", "source-unsafe", "dependency-missing", "dependency-changed", "dependency-unsafe", "target-missing", "target-changed", "target-unsafe"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "expectedHash": { "$ref": "#/$defs/hash" },
        "actualHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
