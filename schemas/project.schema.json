{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demoweave.dev/schemas/project.schema.json",
  "title": "DemoWeave ProjectProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "root", "analyzedAt", "packageManagers", "languages", "frameworks", "surfaces", "commands", "existingDocs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "root": { "type": "string" },
    "analyzedAt": { "type": "string", "format": "date-time" },
    "packageManagers": { "type": "array", "items": { "type": "string" } },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "files"],
        "properties": {
          "name": { "type": "string" },
          "files": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "root"],
        "properties": {
          "name": { "type": "string" },
          "root": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "root", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["terminal", "web", "library", "notebook", "research", "desktop", "mobile", "service", "unknown"] },
          "root": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "label": { "type": "string" },
          "framework": { "type": "string" },
          "command": { "type": "string" },
          "packageName": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "build", "test", "run"],
      "properties": {
        "install": { "type": "array", "items": { "type": "string" } },
        "build": { "type": "array", "items": { "type": "string" } },
        "test": { "type": "array", "items": { "type": "string" } },
        "run": { "type": "array", "items": { "type": "string" } }
      }
    },
    "existingDocs": { "type": "array", "items": { "type": "string" } }
  }
}
